# Local environment for the compose stack. Copy to .env and edit.
#
# .env is gitignored. Never commit real credentials.

DJANGO_SECRET_KEY=local-development-key-not-for-production-use
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

PGDATABASE=mediflow_dev
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=db
PGPORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000