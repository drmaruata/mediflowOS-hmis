# Normalise line endings: check out LF on every platform, but keep files that
# must stay CRLF (Windows scripts) out of the warning loop.
* text=auto eol=lf

# Windows-only batch files genuinely require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.pdf binary